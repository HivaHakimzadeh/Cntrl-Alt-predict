# Copy to .env. Never commit .env.

# --- Generative layer: LOCAL IBM Granite (data never leaves the machine) ---
GRANITE_GGUF_PATH=            # path to the quantized Granite .gguf (the model used in ML Lab 02)
GRANITE_THREADS=4

# --- Switches ---
GUARDRAIL_ML=on               # predictive layer; "off" = rules only
GUARDRAIL_LLM=on              # generative layer; "off" = never call a model (cache is ignored too)

# --- Policy thresholds ---
GUARDRAIL_ALLOW_BELOW=30      # score < 30  -> ALLOW
GUARDRAIL_BLOCK_AT=70         # score >= 70 -> BLOCK, in between -> QUARANTINE

# --- OFF by default: sending content to an external API defeats the on-prem story ---
GUARDRAIL_ALLOW_EXTERNAL_LLM=0
ANTHROPIC_API_KEY=
